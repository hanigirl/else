{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "next build",
  "rewrites": [
    {
      "source": "/",
      "destination": "/learnuiux/newsletter"
    },
    {
      "source": "/privacy",
      "destination": "/learnuiux/privacy"
    },
    {
      "source": "/r/:path*",
      "destination": "/learnuiux/api/r/:path*"
    }
  ]
}
